# ─────────────────────────────────────────────────────────────
# AI InterviewPrep — Environment Variables (example)
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# --- Database (MySQL) ---
DB_URL=jdbc:mysql://localhost:3306/interviewprep
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# --- JWT ---
# Any random string, at least 256 bits (32+ chars) for HS256.
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_characters

# --- Groq API (LLM + Whisper STT) ---
# Get a free key at https://console.groq.com (needed from STEP 016).
GROQ_API_KEY=your_groq_api_key_here

# --- Gemini API (TTS) ---
# Get a free key at https://ai.google.dev (needed from STEP 018).
GEMINI_API_KEY=your_gemini_api_key_here

# --- Resume uploads ---
RESUME_UPLOAD_DIR=./uploads/resumes
